{
  "name": "@milkdown-agent/core",
  "version": "0.1.0",
  "description": "Shared types, parsers, and validators for Milkdown Agent",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^20.19.21",
    "rimraf": "^5.0.5",
    "tsup": "^7.2.0",
    "typescript": "^5.4.5"
  }
}
