{
  "name": "@milkdown-agent/backend-sdk",
  "version": "0.1.0",
  "description": "Backend SDK for parsing and validating Milkdown Agent patches",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@milkdown-agent/core": "workspace:*",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "rimraf": "^5.0.5",
    "tsup": "^7.2.0",
    "typescript": "^5.4.5"
  }
}
