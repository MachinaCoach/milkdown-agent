{
  "name": "@milkdown-agent/suggestion-plugin",
  "version": "0.1.0",
  "description": "Agent-friendly diff suggestion extension for Milkdown editors.",
  "keywords": [
    "milkdown",
    "agent",
    "suggestion",
    "diff",
    "markdown"
  ],
  "homepage": "https://github.com/your-org/milkdown-agent",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./styles/suggestion.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "sideEffects": [
    "./styles/suggestion.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest"
  },
  "peerDependencies": {
    "@milkdown/core": "^7.2.0",
    "@milkdown/prose": "^7.2.0"
  },
  "dependencies": {
    "@milkdown-agent/core": "workspace:*",
    "@milkdown/ctx": "^7.2.0",
    "@milkdown/utils": "^7.2.0",
    "diff-match-patch": "^1.0.5",
    "prosemirror-changeset": "^2.2.1"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "tsup": "^7.2.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
